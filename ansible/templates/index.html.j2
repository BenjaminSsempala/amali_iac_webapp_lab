{# Web page deployed to the EC2 instance by site.yml #}
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ app_title }}</title>
  <style>
    :root { --bg: #f5f7fa; --card: #ffffff; --text: #1f2933; --muted: #616e7c; --accent: #2563eb; --line: #e4e7eb; }
    @media (prefers-color-scheme: dark) {
      :root { --bg: #111827; --card: #1f2937; --text: #f3f4f6; --muted: #9ca3af; --accent: #60a5fa; --line: #374151; }
    }
    * { box-sizing: border-box; }
    body { margin: 0; min-height: 100vh; display: grid; place-items: center; padding: 24px 16px;
           background: var(--bg); color: var(--text); font: 16px/1.5 system-ui, -apple-system, "Segoe UI", sans-serif; }
    main { width: 100%; max-width: 640px; background: var(--card); border: 1px solid var(--line);
           border-radius: 12px; padding: 32px; }
    h1 { margin: 0 0 4px; font-size: 1.6rem; }
    .status { color: var(--accent); font-weight: 600; margin: 0 0 24px; }
    table { width: 100%; border-collapse: collapse; margin-bottom: 24px; }
    th, td { text-align: left; padding: 8px 0; border-bottom: 1px solid var(--line); vertical-align: top; }
    th { color: var(--muted); font-weight: 500; width: 40%; }
    ol { margin: 0 0 24px; padding-left: 20px; }
    footer { color: var(--muted); font-size: 0.9rem; }
  </style>
</head>
<body>
  <main>
    <h1>{{ app_title }}</h1>
    <p class="status">Nginx is running on Amazon EC2</p>

    <table>
      <tr><th>Hostname</th><td>{{ ansible_facts['hostname'] }}</td></tr>
      <tr><th>Private IP</th><td>{{ ansible_facts['default_ipv4']['address'] }}</td></tr>
      <tr><th>Operating system</th><td>{{ ansible_facts['distribution'] }} {{ ansible_facts['distribution_version'] }}</td></tr>
      <tr><th>Kernel</th><td>{{ ansible_facts['kernel'] }}</td></tr>
      <tr><th>Web server</th><td>Nginx</td></tr>
    </table>


    <footer>{{ app_author }} &middot; AmaliTech IaC lab</footer>
  </main>
</body>
</html>
